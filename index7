  let h = '';

  h += card('🏛️ RTO & Registration',
    row('RTO Name', get(rtoData,'rtoName'))+row('RTO Code', get(rtoData,'rtoCode')||get(resp,'rtoCode'))+
    row('State', get(rtoData,'statename'))+row('RTO Active', rtoData.isActive!==undefined ? String(rtoData.isActive) : null)+
    row('Registration Authority', get(resp,'regAuthority'))+row('Registration No', get(resp,'regNo'))+
    row('Registration Date', fmtDate(get(resp,'regDate'))||get(resp,'regDate'))+row('Record ID', get(resp,'id'))+
    row('RTO ID', get(resp,'rtoId'))+row('Combined ID', get(rtoData,'combindID'))+row('Order By', get(rtoData,'orderBy')), next());

  h += card('🔧 Vehicle & Variant',
    row('Manufacturer', get(resp,'manufacturer'))+row('Manufacturer ID', get(resp,'manufacturerId'))+
    row('Manufacturer Month/Year', get(resp,'manufacturerMonthYear'))+row('Manufacturer Year', get(resp,'manufacturerYear'))+
    row('Vehicle', get(resp,'vehicle'))+row('Vehicle ID', get(resp,'vehicleId'))+
    row('Vehicle Type', get(resp,'vehicleType'))+row('Vehicle Class', get(resp,'vehicleClass'))+
    row('Vehicle Age', get(resp,'vehicleAge'))+row('Variant', get(resp,'variant'))+
    row('Variant ID', get(resp,'variantID'))+row('Fuel Type', get(resp,'fuelType'))+
    row('Fuel ID', get(resp,'fuelId'))+row('Cubic Capacity', get(resp,'cubicCapacity'))+
    row('Seat Capacity', get(resp,'seatCapacity'))+row('Is Commercial', resp.isCommercial!==undefined ? String(resp.isCommercial) : null)+
    row('Chassis', get(resp,'chassis'))+row('Engine', get(resp,'engine')), next());

  h += card('👤 Owner & Address',
    row('Owner', get(resp,'owner'))+row("Owner's Father Name", get(resp,'ownerFatherName'))+
    row('Financer', get(resp,'financerName'))+row('Present Address', get(resp,'presentAddress'))+
    row('Permanent Address', get(resp,'permAddress'))+row('Pincode', get(resp,'pincode')), next());

  h += card('🛡️ Insurance, PUCC & Status',
    row('Insurance Company', get(resp,'insuranceCompanyName'))+row('Insurance Company Code', get(resp,'insuranceCompanyCode'))+
    row('Insurance Policy Number', get(resp,'insurancePolicyNumber'))+row('Insurance Valid Upto', fmtDate(get(resp,'insuranceUpto'))||get(resp,'insuranceUpto'))+
    row('Insurance Expired', resp.insuranceExpired!==undefined ? String(resp.insuranceExpired) : null)+
    row('PUCC Number', get(resp,'puccNumber'))+row('PUCC Valid Upto', fmtDate(get(resp,'puccValidUpto'))||get(resp,'puccValidUpto'))+
    row('Status Code', get(resp,'status'))+row('Status Description', get(resp,'statusDesc'))+
    row('Data Status', get(resp,'dataStatus'))+row('Entry Date', get(resp,'eDate'))+
    row('Last Modified Date', get(resp,'lmDate')), next());

  const coveredRto = new Set(['rtoid','rtoName','rtoCode','isActive','combindID','orderBy','statename']);
  const coveredResp = new Set(['rtoData','id','rtoId','regNo','rtoCode','regAuthority','chassis','engine','regDate',
    'manufacturerMonthYear','manufacturerYear','vehicleAge','vehicleClass','puccNumber','puccValidUpto',
    'presentAddress','permAddress','manufacturerId','manufacturer','vehicleId','vehicle','vehicleType',
    'variantID','variant','fuelId','fuelType','cubicCapacity','seatCapacity','isCommercial','owner',
    'ownerFatherName','financerName','insuranceCompanyCode','insuranceCompanyName','insurancePolicyNumber',
    'insuranceUpto','insuranceExpired','status','statusDesc','dataStatus','pincode','eDate','lmDate']);
  const leftover = [
    ...Object.keys(rtoData).filter(k=>!coveredRto.has(k)).map(k=>[k,rtoData[k]]),
    ...Object.keys(resp).filter(k=>!coveredResp.has(k)).map(k=>[k,resp[k]])
  ];
  if(leftover.length){
    h += card('📦 Additional Fields (auto-detected)',
      leftover.map(([k,v]) => {
        const display = (v && typeof v==='object') ? JSON.stringify(v) : v;
        return row(/^[a-z]/i.test(k) ? prettifyKey(k) : k, display);
      }).join(''), next());
  }
  return h;
}

