   ============================================================ */
function setHandoff(state, data){
  const el = $('handoffCard');
  if(!el) return;
  el.classList.remove('found','notfound');
  if(state === 'waiting'){
    el.innerHTML = `
      <div class="handoff-title">🔗 Phase 1 → Phase 2 · Mobile Handoff</div>
      <div class="handoff-status">🔍 Scanning vehicle API responses for a mobile number...</div>
      <div class="handoff-meta">otpking.xyz is the primary source · waiting for responses</div>`;
  } else if(state === 'found'){
    el.classList.add('found');
    el.innerHTML = `
      <div class="handoff-title">✅ Mobile Number Extracted · Forwarding to Phase 2</div>
      <div class="handoff-number">+91 ${esc(data.number)}</div>
      <div class="handoff-meta">Source: <code>${esc(data.source)}</code> · Field: <code>${esc(data.field)}</code></div>
      <div class="handoff-arrow" style="color:var(--green)">⬇️</div>
      <div class="handoff-status" style="color:var(--green)">🚀 Auto-triggering 4 phone APIs with this number...</div>`;
  } else if(state === 'notfound'){
    el.classList.add('notfound');
    el.innerHTML = `
      <div class="handoff-title">⚠️ No Mobile Number Found</div>
      <div class="handoff-status" style="color:var(--red)">None of the 3 vehicle APIs returned a valid Indian mobile number</div>
      <div class="handoff-meta">Phase 2 skipped · Try another vehicle number or paste a mobile directly</div>`;
  }
}

/* ============================================================
   THE HANDOFF TRIGGER — called after EVERY vehicle API arrival
   ============================================================ */
function tryHandoff(){
  if(ST.phase2Started) return;

  const order = [
    { key: 'mR',  name: 'otpking.xyz' },
    { key: 'vR',  name: 'vehicleinfo-byrack.vercel.app' },
    { key: 'vdR', name: 'api-wd7m.onrender.com (vehicle)' }
  ];

  for(const {key, name} of order){
    const resp = ST[key];
    if(!resp || !resp.json) continue;
    const found = deepFindPhone(resp.json);
    if(found){
      log(`🎯 Phone extracted: +91 ${found.number} from ${name} (path: ${found.path})`, 'ok');
      ST.phase2Started = true;
      ST.phone = found.number;
      ST.phoneSource = name;
      ST.phoneField = found.path;
      setHandoff('found', { number: found.number, source: name, field: found.path });
      if(phase2Timer) clearTimeout(phase2Timer);
      phase2Timer = setTimeout(() => {
        phase2Timer = null;
        startPhase2(found.number, name, found.path);
      }, 450);
      return;
    }
  }

  const allSettled = ['mR','vR','vdR'].every(k => ST[k] !== null);
  if(allSettled){
    log(`❌ No phone number found in any of the 3 vehicle API responses`, 'err');
    ST.phase2Started = true;
    ST.phase2Skipped = true;
    setHandoff('notfound');
    Object.keys(ST.phoneStates).forEach(k => { ST.phoneStates[k] = 'done'; });
    maybeFinalize();
  } else {
    setHandoff('waiting');
  }
}

/* ============================================================
   PHASE 2 — fires the moment a phone is available
   ============================================================ */
function startPhase2(number, source, field){
  log(`🚀 PHASE 2 STARTED · number = +91 ${number} · source = ${source} (${field})`, 'step');

  const hdr = document.getElementById('phone-header');
  if(hdr){
    hdr.innerHTML = `<div class="section-divider">
      📱 PART 2 · PHONE OSINT
      <span class="pill">+91 ${esc(number)}</span>
      <small>Mobile extracted from ${esc(source)} (field: ${esc(field)}) · 4 phone APIs running</small>
    </div>`;
  }

  ['nR','lR','aR','l2R'].forEach(k => {
    const el = document.getElementById(`phone-${k}`);
    const label = k==='nR' ? 'Mobile Info' : k==='lR' ? 'Breach Intel' : k==='aR' ? 'Identity/Aadhaar' : 'Leak Intel';
    if(el) el.innerHTML = `<div class="loading-card"><div class="spinner"></div> Fetching ${label} for +91 ${esc(number)}...</div>`;
  });

  phoneFetch('nR', number).then(r => {
    ST.nR = r;
    ST.phoneStates.nR = r.json ? 'done' : (r.httpStatus===404 ? 'nodata' : 'fail');
    const el = document.getElementById('phone-nR'); if(el) el.innerHTML = renderMobileSection(r, number);
    log(`Phone nR settled: ${ST.phoneStates.nR}`, ST.phoneStates.nR==='done'?'ok':'warn');
    maybeFinalize();
  });
  phoneFetch('lR', number).then(r => {
    ST.lR = r;
    ST.phoneStates.lR = r.json ? 'done' : (r.httpStatus===404 ? 'nodata' : 'fail');
    const el = document.getElementById('phone-lR'); if(el) el.innerHTML = renderLeakSection(r);
    log(`Phone lR settled: ${ST.phoneStates.lR}`, ST.phoneStates.lR==='done'?'ok':'warn');
    maybeFinalize();
  });
  phoneFetch('aR', number).then(r => {
    ST.aR = r;
    ST.phoneStates.aR = r.json ? 'done' : (r.httpStatus===404 ? 'nodata' : 'fail');
    const el = document.getElementById('phone-aR'); if(el) el.innerHTML = renderAadharSection(r);
    log(`Phone aR settled: ${ST.phoneStates.aR}`, ST.phoneStates.aR==='done'?'ok':'warn');
    maybeFinalize();
  });
  phoneFetch('l2R', number).then(r => {
    ST.l2R = r;
    ST.phoneStates.l2R = r.json ? 'done' : (r.httpStatus===404 ? 'nodata' : 'fail');
    const el = document.getElementById('phone-l2R'); if(el) el.innerHTML = renderLeak2Section(r);
    log(`Phone l2R settled: ${ST.phoneStates.l2R}`, ST.phoneStates.l2R==='done'?'ok':'warn');
    maybeFinalize();
  });
}

/* ============================================================
   FINALIZE
   ============================================================ */
function maybeFinalize(){
  const vDone = [ST.mState, ST.vState, ST.vdState].every(s => s==='done'||s==='fail');
  const pDone = Object.values(ST.phoneStates).every(s => s==='done'||s==='fail'||s==='nodata');
  if(!vDone || !pDone) return;

  const wasDone = ST.allDone;
  ST.allDone = true;

  renderSummary();

  if(!wasDone){
    log('✅ Pipeline complete · rendering final summary', 'ok');
    $('status').className = 'status';
    $('searchBtn').disabled = false;
    $('pdfFab').classList.add('show');
    ST.lastData = {
      mode: ST.mode, query: ST.query, phone: ST.phone, phoneSource: ST.phoneSource,
      mR: ST.mR, vR: ST.vR, vdR: ST.vdR, nR: ST.nR, lR: ST.lR, aR: ST.aR, l2R: ST.l2R
    };
  }
}

function renderSummary(){
  const sum = document.getElementById('summary');
  if(!sum) return;
  const stOK = s => s==='done' ? '✅ OK' : s==='nodata' ? '⚠️ No data' : s==='fail' ? '❌ Failed' : '⏭️ Skipped';

  if(ST.mode === 'phone'){
    sum.innerHTML = `<div class="sec-title">📡 Complete Fetch Status Summary</div><div class="card full"><div class="card-body">`+
      row('Query (Mobile Number)', ST.query)+
      row('1. /api/number (Mobile Info)', stOK(ST.phoneStates.nR))+
      row('2. /api/leak (Breach Intel)',  stOK(ST.phoneStates.lR))+
      row('3. /api/aadhar (Identity)',    stOK(ST.phoneStates.aR))+
      row('4. /api/leak2 (Leak Intel)',   stOK(ST.phoneStates.l2R))+
    `</div></div><div class="footer">Direct mobile lookup · /api/number · /api/leak · /api/aadhar · /api/leak2<br>Report generated ${new Date().toLocaleString('en-IN')} · Number OSINT</div>`;
    return;
  }

  sum.innerHTML = `<div class="sec-title">📡 Complete Fetch Status Summary</div><div class="card full"><div class="card-body">`+
    row('Query (Vehicle No.)', ST.query)+
    row('Extracted Mobile', ST.phone ? `+91 ${ST.phone}` : '—')+
    row('Extracted From', ST.phoneSource ? `${ST.phoneSource} (field: ${ST.phoneField})` : '—')+
    row('1. otpking.xyz', stOK(ST.mState))+
    row('2. vehicleinfo-byrack.vercel.app', stOK(ST.vState))+
    row('3. api-wd7m.onrender.com (vehicle)', stOK(ST.vdState))+
    row('4. /api/number (Mobile Info)', ST.phone ? stOK(ST.phoneStates.nR) : '⏭️ Skipped')+
    row('5. /api/leak (Breach Intel)',  ST.phone ? stOK(ST.phoneStates.lR) : '⏭️ Skipped')+
    row('6. /api/aadhar (Identity)',    ST.phone ? stOK(ST.phoneStates.aR) : '⏭️ Skipped')+
    row('7. /api/leak2 (Leak Intel)',   ST.phone ? stOK(ST.phoneStates.l2R) : '⏭️ Skipped')+
  `</div></div><div class="footer">7 APIs: otpking.xyz · vehicleinfo-byrack.vercel.app · api-wd7m.onrender.com · /api/number · /api/leak · /api/aadhar · /api/leak2<br>Report generated ${new Date().toLocaleString('en-IN')} · Vehicle → Phone OSINT</div>`;
}

/* ============================================================
   RETRY ONE PHONE API
   ============================================================ */
async function retryPhoneApi(key){
  if(!ST.phone) return;
  const el = document.getElementById(`phone-${key}`);
  if(el) el.innerHTML = `<div class="loading-card"><div class="spinner"></div> Retrying ${key}...</div>`;
  ST.phoneStates[key] = 'active';

  const r = await phoneFetch(key, ST.phone);
  ST[key] = r;
  ST.phoneStates[key] = r.json ? 'done' : (r.httpStatus===404 ? 'nodata' : 'fail');
  if(el){
    if(key==='nR') el.innerHTML = renderMobileSection(r, ST.phone);
    if(key==='lR') el.innerHTML = renderLeakSection(r);
    if(key==='aR') el.innerHTML = renderAadharSection(r);
    if(key==='l2R') el.innerHTML = renderLeak2Section(r);
  }
  maybeFinalize();
}

/* ============================================================
   MAIN ORCHESTRATOR
   ============================================================ */
async function doSearch(){
  const raw = $('inp').value.trim().toUpperCase().replace(/\s+/g,'');
  if(raw.length < 6){ alert('Enter a valid vehicle number (e.g. UP53BC4364) or 10-digit mobile'); return; }

  const isPhoneOnly = /^[6-9]\d{9}$/.test(raw);

  if(phase2Timer){ clearTimeout(phase2Timer); phase2Timer = null; }

  Object.assign(ST, {
    query: raw, mode: isPhoneOnly ? 'phone' : 'vehicle',
    mR:null, vR:null, vdR:null, mState:'pending', vState:'pending', vdState:'pending',
    phone:null, phoneSource:null, phoneField:null,
    phase2Started:false, phase2Skipped:false,
    nR:null, lR:null, aR:null, l2R:null,
    phoneStates:{ nR:'pending', lR:'pending', aR:'pending', l2R:'pending' },
    allDone:false, lastData:null
  });

  clearDebug();
  $('debugToggle').classList.add('show');
  log(`=== New search: ${raw} (mode: ${isPhoneOnly ? 'direct phone' : 'vehicle → phone'}) ===`, 'step');

  if(location.protocol === 'file:'){
    $('hint').style.display = 'none';
    $('results').innerHTML = `<div class="err-card">🚫 Page is opened as a local file (<code>file://</code>) — browsers block every fetch from file://.<br><br>
      <small style="color:var(--yellow)">Deploy to Vercel / Netlify / GitHub Pages, or run <code>python3 -m http.server 8000</code> and open <code>http://localhost:8000/</code>.</small><br><br>
      <button class="btn" onclick="doSearch()">🔁 Retry Search</button></div>`;
    return;
  }

  $('hint').style.display = 'none';
  $('results').innerHTML = '';
  $('pdfFab').classList.remove('show');
  $('searchBtn').disabled = true;
  $('status').className = 'status show';

  /* ---------- DIRECT PHONE MODE ---------- */
  if(isPhoneOnly){
    $('statusTxt').textContent = `Phone OSINT for +91 ${raw}...`;
    $('results').innerHTML = `
      <div class="reg-hero"><div class="reg-plate">${esc(raw)}</div></div>
      <div id="phone-header"><div class="section-divider">📱 PHONE OSINT · Direct Mobile Search <span class="pill">+91 ${esc(raw)}</span><small>4 phone APIs running</small></div></div>
      <div id="phone-nR"></div><div id="phone-lR"></div><div id="phone-aR"></div><div id="phone-l2R"></div>
      <div id="summary"></div>`;
    ['nR','lR','aR','l2R'].forEach(k => {
      const label = k==='nR' ? 'Mobile Info' : k==='lR' ? 'Breach Intel' : k==='aR' ? 'Identity/Aadhaar' : 'Leak Intel';
      document.getElementById(`phone-${k}`).innerHTML = `<div class="loading-card"><div class="spinner"></div> Fetching ${label}...</div>`;
    });
    await Promise.all(['nR','lR','aR','l2R'].map(k =>
      phoneFetch(k, raw).then(r => {
        ST[k] = r;
        ST.phoneStates[k] = r.json ? 'done' : (r.httpStatus===404 ? 'nodata' : 'fail');
        const el = document.getElementById(`phone-${k}`);
        if(el){
          if(k==='nR') el.innerHTML = renderMobileSection(r, raw);
          if(k==='lR') el.innerHTML = renderLeakSection(r);
          if(k==='aR') el.innerHTML = renderAadharSection(r);
          if(k==='l2R') el.innerHTML = renderLeak2Section(r);
        }
      })
    ));
    ST.allDone = true;
    renderSummary();
    $('status').className = 'status';
    $('searchBtn').disabled = false;
    $('pdfFab').classList.add('show');
    ST.lastData = {mode:'phone', query:raw, nR:ST.nR, lR:ST.lR, aR:ST.aR, l2R:ST.l2R};
    log('✅ Direct phone pipeline complete', 'ok');
    return;
  }

  /* ---------- VEHICLE → PHONE MODE ---------- */
  $('statusTxt').textContent = `Fetching vehicle info + phone OSINT for ${raw}...`;
  $('results').innerHTML = `
    <div class="reg-hero"><div class="reg-plate">${esc(raw)}</div></div>
    <div class="section-divider">🚗 PART 1 · VEHICLE OSINT <small>3 vehicle APIs running in parallel</small></div>
    <div class="sec-title">🔹 Source 1: otpking.xyz (Mobile &amp; Chassis)</div>
    <div id="vehicle-mR"><div class="loading-card"><div class="spinner"></div> Fetching otpking.xyz...</div></div>
    <div class="sec-title">🔹 Source 2: vehicleinfo-byrack.vercel.app</div>
    <div id="vehicle-vR"><div class="loading-card"><div class="spinner"></div> Fetching vehicleinfo-byrack...</div></div>
    <div class="sec-title">🔹 Source 3: api-wd7m.onrender.com (vehicle)</div>
    <div id="vehicle-vdR"><div class="loading-card"><div class="spinner"></div> Fetching api-wd7m...</div></div>
    <div id="handoffCard" class="handoff-card">
      <div class="handoff-title">🔗 Phase 1 → Phase 2 · Mobile Handoff</div>
      <div class="handoff-status">🔍 Scanning vehicle API responses for a mobile number...</div>
      <div class="handoff-meta">otpking.xyz is the primary source · waiting for responses</div>
    </div>
    <div id="phone-header"></div>
    <div id="phone-nR"></div><div id="phone-lR"></div><div id="phone-aR"></div><div id="phone-l2R"></div>
    <div id="summary"></div>`;
  setHandoff('waiting');

  function onVehicleArrive(key, resp){
    ST[key] = resp;
    const stateKey = key==='mR' ? 'mState' : key==='vR' ? 'vState' : 'vdState';
    ST[stateKey] = resp.json ? 'done' : 'fail';
    const el = document.getElementById(`vehicle-${key}`);
    if(el){
      if(key==='mR')  el.innerHTML = renderVehicleOtpking(resp);
      if(key==='vR')  el.innerHTML = renderVehicleVdetail(resp, 'vehicleinfo-byrack.vercel.app', '0.14s');
      if(key==='vdR') el.innerHTML = renderVehicleVdetail(resp, 'api-wd7m.onrender.com (vehicle)', '0.18s');
    }
    tryHandoff();
    maybeFinalize();   /* safety net */
  }

  mobileFetch(raw).then(r => onVehicleArrive('mR', r));
  vehicleInfoFetch(raw).then(r => onVehicleArrive('vR', r));
  vdetailFetch(raw).then(r => onVehicleArrive('vdR', r));
}

/* ============================================================
   PDF DOWNLOAD  — clean white paper / black text version
   ============================================================ */
async function downloadPDF(){
  if(!ST.allDone && !ST.lastData){ alert('Please wait — report is still loading.'); return; }
  const fab = $('pdfFab');
  const oldLabel = fab.textContent;
  fab.disabled = true;
  fab.textContent = '⏳ Generating PDF...';
  fab.classList.remove('show');

  const resultsEl = $('results');

  resultsEl.classList.add('pdf-mode');

  document.querySelectorAll('.card').forEach(c => {
    c.style.opacity = '1';
    c.style.transform = 'none';
    c.style.animation = 'none';
  });

  await new Promise(r => setTimeout(r, 350));

  const stamp = new Date().toISOString().slice(0,10);
  const fname = ST.mode === 'phone'
    ? `PhoneOSINT_${ST.query}_${stamp}.pdf`
    : `VehiclePhoneOSINT_${ST.query}_${stamp}.pdf`;

  const opt = {
    margin: [10, 8, 14, 8],
    filename: fname,
    image: { type: 'jpeg', quality: 0.96 },
    html2canvas: {
      scale: 2,
      backgroundColor: '#ffffff',
      useCORS: true,
      allowTaint: false,
      logging: false,
      windowWidth: resultsEl.scrollWidth
    },
    jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
    pagebreak: { mode: ['css', 'legacy'], avoid: ['.card', '.api-panel-head', '.handoff-card', '.section-divider'] }
  };

  try{
    await html2pdf().set(opt).from(resultsEl).save();
    log('📥 PDF downloaded (white paper / black text)', 'ok');
  }catch(e){
    log('❌ PDF generation failed: ' + (e?.message||e), 'err');
    alert('PDF generation failed: ' + (e?.message || e) + '\n\nTip: very long reports may need a second attempt.');
  }finally{
    resultsEl.classList.remove('pdf-mode');
    document.querySelectorAll('.card').forEach(c => {
      c.style.opacity = '';
      c.style.transform = '';
      c.style.animation = '';
    });
    fab.disabled = false;
    fab.textContent = oldLabel;
    fab.classList.add('show');
  }
}
</script>
