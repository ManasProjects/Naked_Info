<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Vehicle → Phone OSINT</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#0a0a0f;--card:#12121a;--card2:#1a1a26;--border:#2a2a3d;
  --accent:#6c63ff;--green:#00d4aa;--red:#ff4757;--yellow:#ffa502;
  --text:#e8e8f0;--sub:#8888aa
}
body{background:var(--bg);color:var(--text);font-family:'Segoe UI',sans-serif;min-height:100vh}
.hero{background:linear-gradient(135deg,#0a0a0f,#12102a,#0a0a0f);padding:36px 20px 28px;text-align:center;border-bottom:1px solid var(--border)}
.logo{font-size:2.2rem;font-weight:800}.logo span{color:var(--accent)}
.tagline{color:var(--sub);margin-top:6px;font-size:.9rem}
.search-wrap{max-width:540px;margin:24px auto 0}
.search-box{display:flex;gap:8px;background:var(--card2);border:1px solid var(--border);border-radius:14px;padding:8px 8px 8px 18px;align-items:center;transition:border-color .2s}
.search-box:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px rgba(108,99,255,.15)}
.search-box input{flex:1;background:none;border:none;outline:none;color:var(--text);font-size:1.1rem;font-weight:700;letter-spacing:2px;text-transform:uppercase}
.search-box input::placeholder{color:var(--sub);font-weight:400;letter-spacing:0;text-transform:none;font-size:.95rem}
.btn{background:linear-gradient(135deg,var(--accent),#8b5cf6);border:none;color:#fff;padding:10px 22px;border-radius:10px;font-size:.95rem;font-weight:700;cursor:pointer;transition:opacity .2s}
.btn:hover{opacity:.85}.btn:disabled{opacity:.5;cursor:not-allowed}
.btn.small{padding:6px 12px;font-size:.8rem;border-radius:8px}
.examples{margin-top:10px;color:var(--sub);font-size:.8rem}
.examples span{display:inline-block;background:var(--card2);border:1px solid var(--border);border-radius:6px;padding:3px 10px;margin:3px;cursor:pointer;transition:border-color .2s}
.examples span:hover{border-color:var(--accent);color:var(--accent)}
.container{max-width:960px;margin:0 auto;padding:24px 14px 120px}
.status{background:var(--card2);border:1px solid var(--border);border-radius:12px;padding:14px 18px;margin-bottom:18px;display:none;align-items:center;gap:12px}
.status.show{display:flex}
.spinner{width:20px;height:20px;border:3px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin .7s linear infinite;flex-shrink:0}
@keyframes spin{to{transform:rotate(360deg)}}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:14px}
.card{background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden;animation:fadeUp .35s ease forwards;opacity:0;page-break-inside:avoid}
@keyframes fadeUp{to{opacity:1;transform:translateY(0)}from{opacity:0;transform:translateY(14px)}}
.card-head{padding:13px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px;font-weight:700;font-size:.92rem;flex-wrap:wrap}
.card-body{padding:14px 16px}
.row{display:flex;justify-content:space-between;align-items:flex-start;padding:6px 0;border-bottom:1px solid rgba(255,255,255,.04)}
.row:last-child{border-bottom:none}
.lbl{color:var(--sub);font-size:.8rem;flex:0 0 44%}
.val{font-size:.85rem;font-weight:600;text-align:right;word-break:break-word;flex:0 0 54%}
.badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:20px;font-size:.78rem;font-weight:700}
.green{background:rgba(0,212,170,.12);color:var(--green);border:1px solid rgba(0,212,170,.25)}
.red{background:rgba(255,71,87,.12);color:var(--red);border:1px solid rgba(255,71,87,.25)}
.yellow{background:rgba(255,165,2,.12);color:var(--yellow);border:1px solid rgba(255,165,2,.25)}
.purple{background:rgba(108,99,255,.12);color:var(--accent);border:1px solid rgba(108,99,255,.25)}
.tag{display:inline-block;background:var(--card2);border:1px solid var(--border);border-radius:6px;padding:2px 8px;font-size:.82rem;font-weight:600}
.full{grid-column:1/-1}
.err-card{background:rgba(255,71,87,.08);border:1px solid rgba(255,71,87,.2);border-radius:14px;padding:20px;text-align:center;color:var(--red);margin-bottom:14px}
.loading-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:20px;text-align:center;color:var(--sub);margin-bottom:14px;display:flex;align-items:center;justify-content:center;gap:10px}
.reg-hero{text-align:center;margin-bottom:18px}
.reg-plate{display:inline-block;background:var(--card2);border:2px solid var(--accent);border-radius:8px;padding:6px 20px;font-size:1.4rem;font-weight:800;letter-spacing:3px;color:var(--accent)}
.hint{background:rgba(108,99,255,.06);border:1px solid rgba(108,99,255,.15);border-radius:12px;padding:20px;text-align:center;margin-top:24px}
.hint p{color:var(--sub);font-size:.85rem;line-height:1.8}
.sec-title{font-size:.7rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--sub);margin:20px 0 10px}
.section-divider{margin:30px 0 6px;padding:16px 18px;border-radius:14px;background:linear-gradient(135deg,rgba(108,99,255,.14),rgba(0,212,170,.08));border:1px solid var(--border);text-align:center;font-weight:800;font-size:1.02rem;letter-spacing:1px;display:flex;flex-direction:column;align-items:center;gap:5px}
.section-divider .pill{background:var(--green);color:#000;padding:3px 12px;border-radius:20px;font-size:.85rem;font-weight:800;letter-spacing:1px}
.section-divider small{color:var(--sub);font-weight:500;letter-spacing:0;font-size:.75rem}
.handoff-card{margin:26px 0;padding:22px 24px;border-radius:16px;background:linear-gradient(135deg,rgba(108,99,255,.14),rgba(0,212,170,.08));border:2px solid var(--accent);text-align:center;position:relative;overflow:hidden;transition:border-color .4s,background .4s}
.handoff-card.found{border-color:var(--green);background:linear-gradient(135deg,rgba(0,212,170,.18),rgba(0,212,170,.06));animation:foundPop .5s ease-out}
.handoff-card.notfound{border-color:var(--red);background:linear-gradient(135deg,rgba(255,71,87,.14),rgba(255,71,87,.04))}
@keyframes foundPop{0%{transform:scale(1)}40%{transform:scale(1.02)}100%{transform:scale(1)}}
.handoff-title{font-size:.72rem;letter-spacing:2.5px;text-transform:uppercase;color:var(--sub);margin-bottom:10px;font-weight:700}
.handoff-status{font-size:.98rem;font-weight:700;color:var(--text);margin-bottom:4px}
.handoff-number{font-size:2rem;font-weight:900;letter-spacing:3px;color:var(--green);margin:8px 0;font-family:'Courier New',monospace;text-shadow:0 0 22px rgba(0,212,170,.5)}
.handoff-meta{font-size:.78rem;color:var(--sub);margin-top:4px}
.handoff-meta code{background:var(--card2);border:1px solid var(--border);padding:1px 6px;border-radius:4px;color:var(--accent);font-size:.75rem}
.handoff-arrow{font-size:2rem;color:var(--accent);margin:10px 0 4px;animation:bounce 1s infinite}
@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(8px)}}
.handoff-arrow.done{animation:none;color:var(--green)}
.api-panel{border-radius:16px;border:1px solid var(--border);margin:22px 0;overflow:hidden;background:rgba(255,255,255,.015)}
.api-panel-head{padding:14px 18px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;border-bottom:2px solid;font-weight:800;font-size:.95rem}
.api-panel-body{padding:16px 16px 4px}
.api-src{color:var(--sub);font-size:.72rem;font-weight:500}
.api-1{border-color:rgba(108,99,255,.35)} .api-1 .api-panel-head{background:rgba(108,99,255,.08);border-bottom-color:var(--accent);color:var(--accent)}
.api-2{border-color:rgba(255,71,87,.3)} .api-2 .api-panel-head{background:rgba(255,71,87,.08);border-bottom-color:var(--red);color:#ff8189}
.api-3{border-color:rgba(0,212,170,.3)} .api-3 .api-panel-head{background:rgba(0,212,170,.08);border-bottom-color:var(--green);color:var(--green)}
.api-4{border-color:rgba(56,189,248,.3)} .api-4 .api-panel-head{background:rgba(56,189,248,.08);border-bottom-color:#38bdf8;color:#38bdf8}
.footer{text-align:center;color:var(--sub);font-size:.75rem;padding:16px;border-top:1px solid var(--border);margin-top:20px}
.pdf-fab{position:fixed;right:20px;bottom:20px;z-index:999;background:linear-gradient(135deg,#00d4aa,#0891b2);border:none;color:#fff;padding:14px 22px;border-radius:50px;font-size:.95rem;font-weight:800;cursor:pointer;box-shadow:0 8px 28px rgba(0,212,170,.4);display:none;align-items:center;gap:8px}
.pdf-fab.show{display:inline-flex}
.pdf-fab:hover{opacity:.9}
.pdf-fab:disabled{opacity:.6;cursor:wait}
.debug-toggle{position:fixed;left:20px;bottom:20px;z-index:999;background:var(--card2);border:1px solid var(--border);color:var(--text);width:44px;height:44px;border-radius:50%;cursor:pointer;font-size:1.1rem;display:none}
.debug-toggle.show{display:block}
.debug-toggle:hover{border-color:var(--accent)}
.debug-panel{position:fixed;left:20px;bottom:74px;width:440px;max-width:calc(100vw - 40px);max-height:320px;background:#000;border:1px solid var(--border);border-radius:12px;display:none;z-index:998;overflow:hidden;font-family:'Courier New',monospace;font-size:.72rem}
.debug-panel.show{display:block}
.debug-head{padding:8px 12px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;background:var(--card2);color:var(--accent);font-weight:700}
.debug-head button{background:var(--card);border:1px solid var(--border);color:var(--text);padding:2px 8px;border-radius:4px;font-size:.7rem;cursor:pointer;margin-left:6px}
.debug-body{padding:8px 12px;color:#9ae6b4;overflow-y:auto;max-height:260px;line-height:1.55;white-space:pre-wrap;word-break:break-word}
.debug-body .log-line{display:block;padding:1px 0}
.debug-body .log-line.err{color:#fc8181}
.debug-body .log-line.warn{color:#f6ad55}
.debug-body .log-line.ok{color:#68d391}
.debug-body .log-line.info{color:#63b3ed}
.debug-body .log-line.step{color:#d6bcfa;font-weight:700}

/* ============================================================
   PDF LIGHT MODE — applied temporarily on #results during
   html2pdf capture → produces a white-paper PDF with black text
   ============================================================ */
.pdf-mode{
  --bg:#ffffff !important;
  --card:#ffffff !important;
  --card2:#f7f7f9 !important;
  --border:#cccccc !important;
  --accent:#3333cc !important;
  --green:#008866 !important;
  --red:#cc2233 !important;
  --yellow:#cc8800 !important;
  --text:#000000 !important;
  --sub:#555555 !important;
  background:#ffffff !important;
  color:#000000 !important;
  padding:6px !important;
}
.pdf-mode *{color:#000000;text-shadow:none !important;box-shadow:none !important}
.pdf-mode .pdf-fab,.pdf-mode .debug-toggle,.pdf-mode .debug-panel{display:none !important}
.pdf-mode .card{background:#ffffff !important;border:1px solid #cccccc !important;animation:none !important;opacity:1 !important;transform:none !important}
.pdf-mode .card-head{background:#f7f7f9 !important;color:#000000 !important;border-bottom:1px solid #cccccc !important}
.pdf-mode .card-body{background:#ffffff !important}
.pdf-mode .row{border-bottom:1px solid #e8e8e8 !important}
.pdf-mode .lbl{color:#555555 !important}
.pdf-mode .val{color:#000000 !important}
.pdf-mode .sec-title{color:#444444 !important}
.pdf-mode .tag{background:#f0f0f0 !important;color:#000000 !important;border:1px solid #cccccc !important}
.pdf-mode .badge{background:#f0f0f0 !important;color:#000000 !important;border:1px solid #cccccc !important}
.pdf-mode .badge.green{background:#e6f7f2 !important;color:#006644 !important;border-color:#00a884 !important}
.pdf-mode .badge.red{background:#fdecea !important;color:#992233 !important;border-color:#cc2233 !important}
.pdf-mode .badge.yellow{background:#fef7e6 !important;color:#885500 !important;border-color:#cc8800 !important}
.pdf-mode .badge.purple{background:#eeeeff !important;color:#3333cc !important;border-color:#3333cc !important}
.pdf-mode .section-divider{background:#f0f0ff !important;border:1px solid #cccccc !important;color:#000000 !important}
.pdf-mode .section-divider .pill{background:#00a884 !important;color:#ffffff !important}
.pdf-mode .section-divider small{color:#555555 !important}
.pdf-mode .reg-plate{background:#f5f5f5 !important;border:2px solid #333333 !important;color:#333333 !important}
.pdf-mode .api-panel{background:#ffffff !important;border:1px solid #cccccc !important}
.pdf-mode .api-panel-body{background:#ffffff !important}
.pdf-mode .api-1{border-color:#3333cc !important}
.pdf-mode .api-1 .api-panel-head{background:#eeeeff !important;color:#3333cc !important;border-bottom-color:#3333cc !important}
.pdf-mode .api-2{border-color:#cc2233 !important}
.pdf-mode .api-2 .api-panel-head{background:#fdecea !important;color:#cc2233 !important;border-bottom-color:#cc2233 !important}
.pdf-mode .api-3{border-color:#008866 !important}
.pdf-mode .api-3 .api-panel-head{background:#e6f7f2 !important;color:#008866 !important;border-bottom-color:#008866 !important}
.pdf-mode .api-4{border-color:#0a7bb5 !important}
.pdf-mode .api-4 .api-panel-head{background:#e6f4fb !important;color:#0a7bb5 !important;border-bottom-color:#0a7bb5 !important}
.pdf-mode .api-src{color:#666666 !important}
.pdf-mode .loading-card{background:#f7f7f9 !important;color:#333333 !important;border:1px solid #cccccc !important}
.pdf-mode .err-card{background:#fff5f5 !important;color:#cc2233 !important;border:1px solid #f0c0c0 !important}
.pdf-mode .hint{background:#f0f0ff !important;border:1px solid #cccccc !important}
.pdf-mode .hint p{color:#333333 !important}
.pdf-mode .footer{color:#555555 !important;border-top:1px solid #cccccc !important;background:#ffffff !important}
.pdf-mode .handoff-card{background:#f0fff4 !important;border:2px solid #00a884 !important}
.pdf-mode .handoff-card.notfound{background:#fff5f5 !important;border-color:#cc2233 !important}
.pdf-mode .handoff-title{color:#555555 !important}
.pdf-mode .handoff-status{color:#000000 !important}
.pdf-mode .handoff-number{color:#006644 !important;text-shadow:none !important}
.pdf-mode .handoff-meta{color:#555555 !important}
.pdf-mode .handoff-meta code{background:#f0f0f0 !important;color:#333333 !important;border:1px solid #cccccc !important}
.pdf-mode .handoff-arrow{color:#00a884 !important;animation:none !important}
.pdf-mode .btn{display:none !important}
.pdf-mode .grid{gap:10px !important}

@media(max-width:580px){
  .logo{font-size:1.7rem}.grid{grid-template-columns:1fr}.search-box input{font-size:.95rem}.btn{padding:10px 14px}
  .pdf-fab{right:12px;bottom:12px;padding:12px 16px;font-size:.85rem}
  .debug-toggle{left:12px;bottom:12px}
  .debug-panel{left:12px;right:12px;width:auto;bottom:66px}
  .handoff-number{font-size:1.5rem;letter-spacing:2px}
}
</style>
</head>
<body>

<div class="hero">
  <div class="logo">🚗 Vehicle <span>→</span> 📱 Phone <span>OSINT</span></div>
  <div class="tagline">1 Search Box · 7 APIs · Vehicle Info → Mobile Number → Full Phone Intelligence → PDF</div>
  <div class="search-wrap">
    <div class="search-box">
      <input type="text" id="inp" placeholder="Enter Vehicle No. (e.g. UP53BC4364) or 10-digit Mobile" maxlength="11" autocomplete="off"/>
      <button class="btn" id="searchBtn" onclick="doSearch()">🔍 Search</button>
    </div>
    <div class="examples">
      Try: <span onclick="fill('UP53BC4364')">UP53BC4364</span>
           <span onclick="fill('CG24K5483')">CG24K5483</span>
           <span onclick="fill('MH12AB1234')">MH12AB1234</span>
    </div>
  </div>
</div>

<div class="container">
  <div class="status" id="status"><div class="spinner"></div><span id="statusTxt">Fetching...</span></div>
  <div id="results"></div>
  <div class="hint" id="hint">
    <p>🔐 Enter any Indian vehicle registration number → the tool auto-resolves the owner's<br>
    mobile number and then runs the full phone OSINT suite on it (all in one click).<br>
    Every API's complete raw response is shown, and everything downloads as a single PDF.</p>
  </div>
</div>

<button class="pdf-fab" id="pdfFab" onclick="downloadPDF()">📥 Download PDF</button>
<button class="debug-toggle" id="debugToggle" onclick="toggleDebug()" title="Pipeline log">🐛</button>
<div class="debug-panel" id="debugPanel">
  <div class="debug-head"><span>🐛 Pipeline Log</span><span><button onclick="clearDebug()">Clear</button><button onclick="toggleDebug()">✕</button></span></div>
  <div class="debug-body" id="debugBody"></div>
</div>

<script>
/* ============================================================
   CONFIG
   ============================================================ */
const MOBILE_API_BASE       = 'https://otpking.xyz/vehicle';
const VEHICLE_INFO_API_BASE = 'https://vehicleinfo-byrack.vercel.app/api';
const VDETAIL_API_BASE      = 'https://api-wd7m.onrender.com/api';

const PHONE_ENDPOINTS = {
  nR : { rel:'/api/number', upstream:'https://anshapi.vercel.app/api/num?key=anshpapa&number=%N%',                        label:'anshapi.vercel.app' },
  lR : { rel:'/api/leak',   upstream:'https://number-info-for-my-rasmalai-ayushi.vercel.app/NumberByAyush?key=QTS&Number=%N%', label:'number-info-for-my-rasmalai-ayushi.vercel.app' },
  aR : { rel:'/api/aadhar', upstream:'https://number-info-what.vercel.app/open/search?mobile=%N%',                       label:'number-info-what.vercel.app' },
  l2R: { rel:'/api/leak2',  upstream:'https://api-wd7m.onrender.com/api?key=sharma&number=%2B91%N%&type=leak',          label:'api-wd7m.onrender.com (leak)' }
};

/* ============================================================
   HELPERS
   ============================================================ */
const $ = id => document.getElementById(id);
function fill(v){ $('inp').value = v; doSearch(); }
$('inp').addEventListener('keydown', e => { if(e.key === 'Enter') doSearch(); });

function esc(s){
  return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
}
function valid(v){
  return v !== undefined && v !== null && String(v).trim() !== '' &&
         !['null','undefined','N/A','NA','None','none','--'].includes(String(v).trim());
}
function get(obj, path, fallback=null){
  try{
    const v = path.split('.').reduce((a,k)=>a?.[k], obj);
    return valid(v) ? v : fallback;
  }catch(e){ return fallback; }
}
function fmtDate(v){
  if(!valid(v)) return null;
  const s = String(v).split('T')[0].split(' ')[0];
  let d;
  if(/^\d{4}-\d{2}-\d{2}$/.test(s)) d = new Date(s+'T00:00:00');
  else if(/^\d{2}\/\d{4}$/.test(s)){ const [m,y]=s.split('/'); return `${m}/${y}`; }
  else if(/^(\d{1,2})-(\d{1,2})-(\d{4})$/.test(s)){
    const [,dd,mm,yyyy] = s.match(/^(\d{1,2})-(\d{1,2})-(\d{4})$/);
    d = new Date(`${yyyy}-${mm.padStart(2,'0')}-${dd.padStart(2,'0')}T00:00:00`);
  }
  else if(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.test(s)){
    const [,dd,mm,yyyy] = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    d = new Date(`${yyyy}-${mm.padStart(2,'0')}-${dd.padStart(2,'0')}T00:00:00`);
  }
  else d = new Date(s);
  if(isNaN(d)) return String(v);
  return d.toLocaleDateString('en-IN',{day:'2-digit',month:'long',year:'numeric'});
}
function badgeStatus(text, type='green'){
  const cls = type==='red'?'red':type==='yellow'?'yellow':'green';
  return `<span class="badge ${cls}">${esc(text)}</span>`;
}
function row(label, value, html=false){
  if(!valid(value)) return '';
  return `<div class="row"><span class="lbl">${esc(label)}</span><span class="val">${html?value:esc(value)}</span></div>`;
}
function rowRaw(label, value){
  const display = (value===null || value===undefined || String(value).trim()==='')
    ? '<span class="tag">null</span>' : esc(String(value));
  return `<div class="row"><span class="lbl">${esc(label)}</span><span class="val">${display}</span></div>`;
}
function safeStr(v){ return (v===undefined || v===null || String(v).trim()==='') ? 'N/A' : String(v); }
function card(title, body, delay='.05s'){
  return `<div class="card" style="animation-delay:${delay}"><div class="card-head">${title}</div><div class="card-body">${body}</div></div>`;
}
function humanizeKey(k){ return String(k).replace(/([a-z0-9])([A-Z])/g,'$1 $2').replace(/_/g,' ').trim(); }
function prettifyKey(k){ return String(k).replace(/_/g,' ').replace(/\b\w/g, c => c.toUpperCase()); }
function renderAllKeys(obj, known){
  known = known || {};
  let body = '';
  Object.keys(obj).forEach(k => { body += rowRaw(known[k] || humanizeKey(k), obj[k]); });
  return body;
}
function countValid(obj){
  if(!obj || typeof obj!=='object') return 0;
  return Object.values(obj).filter(v => valid(v) && typeof v!=='object').length;
}

/* ============================================================
   DEBUG LOG
   ============================================================ */
function log(msg, kind='info'){
  const body = $('debugBody');
  if(body){
    const line = document.createElement('span');
    line.className = 'log-line ' + kind;
    const ts = new Date().toLocaleTimeString('en-IN',{hour12:false});
    line.textContent = `[${ts}] ${msg}`;
    body.appendChild(line);
    body.scrollTop = body.scrollHeight;
  }
  const fn = kind==='err' ? 'error' : kind==='warn' ? 'warn' : 'log';
  console[fn]('[OSINT]', msg);
}
function clearDebug(){ const b=$('debugBody'); if(b) b.innerHTML=''; }
function toggleDebug(){ const p = $('debugPanel'); if(p) p.classList.toggle('show'); }

/* ============================================================
   CORS-PROXY RESILIENT FETCH
   ============================================================ */
const CORS_PROXIES = [
  u => u,
  u => `https://api.codetabs.com/v1/proxy?quest=${encodeURIComponent(u)}`,
  u => `https://api.cors.lol/url=${u}`,
  u => `https://api.allorigins.win/raw?url=${encodeURIComponent(u)}`,
  u => `https://r.jina.ai/${u}`
];
function looksLikeProxyRejection(json){
  if(!json || typeof json!=='object' || Array.isArray(json)) return false;
  const keys = Object.keys(json);
  if(keys.length===1 && keys[0]==='error') return true;
  if(keys.length<=2 && typeof json.error==='string' && /api key|unauthorized|rate limit|quota/i.test(json.error)) return true;
  return false;
}
async function attemptFetch(buildUrl, targetUrl, timeoutMs){
  const url = buildUrl(targetUrl);
  const label = url===targetUrl ? 'direct' : (new URL(url).hostname);
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs);
  try{
    const r = await fetch(url, {method:'GET', headers:{accept:'application/json'}, signal:controller.signal});
    clearTimeout(timer);
    const raw = await r.text();
    let json = null;
    try{ json = JSON.parse(raw); }
    catch(e){ const m = raw.match(/\{[\s\S]*\}/); if(m){ try{ json = JSON.parse(m[0]); }catch(e2){} } }
    if(!json) throw new Error(`${label}: HTTP ${r.status}, invalid JSON`);
    if(looksLikeProxyRejection(json)) throw new Error(`${label}: proxy rejected (${json.error})`);
    const inner = get(json,'data.content');
    if(typeof inner === 'string' && json.code !== undefined && json.status !== undefined){
      try{ json = JSON.parse(inner); }
      catch(e3){ const m = inner.match(/\{[\s\S]*\}/); if(m){ try{ json = JSON.parse(m[0]); }catch(e4){} } }
    }
    return {json, raw, httpStatus:r.status, parseError:null};
  }catch(e){
    clearTimeout(timer);
    const reason = e.name==='AbortError' ? `Timed out after ${timeoutMs/1000}s` : (e.message||String(e));
    throw new Error(reason.startsWith(label) ? reason : `${label}: ${reason}`);
  }
}
async function resilientFetch(targetUrl){
  const schedule = [10000, 16000, 22000];
  let lastErrors = [];
  for(let i=0; i<schedule.length; i++){
    try{ return await Promise.any(CORS_PROXIES.map(b => attemptFetch(b, targetUrl, schedule[i]))); }
    catch(agg){
      lastErrors = (agg.errors||[]).map(e => e.message||String(e));
      if(i < schedule.length-1) await new Promise(r => setTimeout(r, 500));
    }
  }
  return {json:null, raw:'', httpStatus:0, parseError:lastErrors.join(' | '), allFailed:true};
}

