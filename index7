async function phoneFetch(endpointKey, number){
  const cfg = PHONE_ENDPOINTS[endpointKey];
  if(!cfg) return {json:null, parseError:`Unknown endpoint ${endpointKey}`};
  log(`→ Phone ${endpointKey}: calling /api/... for +91 ${number}`, 'step');
  try{
    const r = await fetch(`${cfg.rel}?number=${encodeURIComponent(number)}`, {headers:{accept:'application/json'}});
    const text = await r.text();
    const t = text.trim();
    if(t.startsWith('{') || t.startsWith('[')){
      try{
        const json = JSON.parse(text);
        log(`✅ Phone ${endpointKey}: serverless OK (HTTP ${r.status})`, 'ok');
        return {json, raw:text, httpStatus:r.status, parseError:null, _via:'serverless'};
      }catch(e){ /* not JSON */ }
    }
    log(`⚠️ Phone ${endpointKey}: serverless returned non-JSON (HTTP ${r.status}) → proxy fallback`, 'warn');
  }catch(e){
    log(`⚠️ Phone ${endpointKey}: serverless unreachable (${e.message}) → proxy fallback`, 'warn');
  }
  const upstreamUrl = cfg.upstream.replace('%N%', encodeURIComponent(number));
  const result = await resilientFetch(upstreamUrl);
  if(result.json){
    log(`✅ Phone ${endpointKey}: proxy fallback OK`, 'ok');
    result._via = 'proxy-fallback';
    return result;
  }
  log(`❌ Phone ${endpointKey}: both serverless & proxy failed`, 'err');
  return {json:null, raw:'', httpStatus:0, parseError:`Serverless & proxy both failed`, _via:'failed'};
}

/* ============================================================
   DEEP PHONE EXTRACTION
   ============================================================ */
const PHONE_KEY_HINTS = ['mobile','phone','contact','whatsapp','cell','telephone','number','num'];
const ALT_KEY_HINTS   = ['alt','alternate','secondary','other'];
const BAD_KEY_HINTS   = ['chassis','engine','regno','registration','pincode','pin','aadhar','aadhaar','id','record','rto','vehicleid','variantid','manufacturerid','fuelid','cubic','challan','receipt'];

function looksLikeIndianMobile(str){
  if(str === null || str === undefined) return null;
  const digits = String(str).replace(/\D/g,'');
  if(digits.length < 10 || digits.length > 13) return null;
  const last10 = digits.slice(-10);
  if(/^[6-9]\d{9}$/.test(last10)) return last10;
  return null;
}

function deepFindPhone(obj, path='', depth=0){
  if(depth > 7 || obj === null || obj === undefined) return null;
  if(typeof obj === 'string' || typeof obj === 'number'){
    const lowerPath = (path || '').toLowerCase();
    if(BAD_KEY_HINTS.some(b => lowerPath.includes(b))) return null;
    const mobile = looksLikeIndianMobile(obj);
    if(mobile) return { number: mobile, path: path || '(root)' };
    return null;
  }
  if(typeof obj !== 'object') return null;
  const keys = Object.keys(obj);
  const sorted = [...keys].sort((a,b) => {
    const la = a.toLowerCase(), lb = b.toLowerCase();
    const sa = (PHONE_KEY_HINTS.some(k => la.includes(k)) ? -3 : 0) + (ALT_KEY_HINTS.some(k => la.includes(k)) ? -1 : 0);
    const sb = (PHONE_KEY_HINTS.some(k => lb.includes(k)) ? -3 : 0) + (ALT_KEY_HINTS.some(k => lb.includes(k)) ? -1 : 0);
    return sa - sb;
  });
  for(const k of sorted){
    const childPath = path ? `${path}.${k}` : k;
    const found = deepFindPhone(obj[k], childPath, depth+1);
    if(found) return found;
  }
  return null;
}

